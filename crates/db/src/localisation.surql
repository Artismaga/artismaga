DEFINE TABLE IF NOT EXISTS localisation_state SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS revision ON localisation_state TYPE int;
DEFINE FIELD IF NOT EXISTS source_locale ON localisation_state TYPE string;
DEFINE FIELD IF NOT EXISTS enabled ON localisation_state TYPE array<string>;
DEFINE TABLE IF NOT EXISTS localisation_key SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS key ON localisation_key TYPE string;
DEFINE FIELD IF NOT EXISTS definition ON localisation_key TYPE object FLEXIBLE;
DEFINE INDEX IF NOT EXISTS localisation_key_key ON localisation_key FIELDS key UNIQUE;
DEFINE TABLE IF NOT EXISTS localisation_override SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS key ON localisation_override TYPE string;
DEFINE FIELD IF NOT EXISTS locale ON localisation_override TYPE string;
DEFINE FIELD IF NOT EXISTS live ON localisation_override TYPE option<string>;
DEFINE FIELD IF NOT EXISTS draft ON localisation_override TYPE option<string>;
DEFINE FIELD IF NOT EXISTS revision ON localisation_override TYPE int;
DEFINE FIELD IF NOT EXISTS author ON localisation_override TYPE string;
DEFINE INDEX IF NOT EXISTS localisation_override_key ON localisation_override FIELDS key,locale UNIQUE;
DEFINE TABLE IF NOT EXISTS translation_settings SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS revision ON translation_settings TYPE int;
DEFINE FIELD IF NOT EXISTS value ON translation_settings TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS secret ON translation_settings TYPE option<string>;
DEFINE TABLE IF NOT EXISTS translation_cache SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS key ON translation_cache TYPE string;
DEFINE FIELD IF NOT EXISTS scope ON translation_cache TYPE option<string>;
DEFINE FIELD IF NOT EXISTS value ON translation_cache TYPE string;
DEFINE FIELD IF NOT EXISTS encoding ON translation_cache TYPE option<string>;
DEFINE FIELD IF NOT EXISTS expires ON translation_cache TYPE int;
DEFINE FIELD IF NOT EXISTS provider_revision ON translation_cache TYPE int;
DEFINE INDEX IF NOT EXISTS translation_cache_key ON translation_cache FIELDS key UNIQUE;
DEFINE TABLE IF NOT EXISTS work_translation_source SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS work ON work_translation_source TYPE string;
DEFINE FIELD IF NOT EXISTS locale ON work_translation_source TYPE string;
DEFINE TABLE IF NOT EXISTS work_translation_access SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS work ON work_translation_access TYPE string;
DEFINE FIELD IF NOT EXISTS uid ON work_translation_access TYPE string;
DEFINE FIELD IF NOT EXISTS locale ON work_translation_access TYPE string;
DEFINE FIELD IF NOT EXISTS can_draft ON work_translation_access TYPE bool;
DEFINE FIELD IF NOT EXISTS can_approve ON work_translation_access TYPE bool;
DEFINE INDEX IF NOT EXISTS work_translation_access_unique ON work_translation_access FIELDS work,uid,locale UNIQUE;
DEFINE TABLE IF NOT EXISTS work_translation SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS work ON work_translation TYPE string;
DEFINE FIELD IF NOT EXISTS scope ON work_translation TYPE string;
DEFINE FIELD IF NOT EXISTS locale ON work_translation TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON work_translation TYPE int;
DEFINE FIELD IF NOT EXISTS value ON work_translation TYPE object FLEXIBLE;
DEFINE INDEX IF NOT EXISTS work_translation_unique ON work_translation FIELDS work,scope,locale UNIQUE;

DEFINE FIELD IF NOT EXISTS translation_only ON work_share TYPE bool DEFAULT false;
