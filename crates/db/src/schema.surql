-- Idempotent foundation migration. New migrations must be additive and versioned.
BEGIN TRANSACTION;
DEFINE TABLE IF NOT EXISTS account SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON account TYPE string;
DEFINE FIELD IF NOT EXISTS email ON account TYPE string;
DEFINE FIELD IF NOT EXISTS display_name ON account TYPE string;
DEFINE FIELD IF NOT EXISTS password_hash ON account TYPE string;
DEFINE FIELD IF NOT EXISTS group_key ON account TYPE string;
DEFINE FIELD IF NOT EXISTS email_verified ON account TYPE bool DEFAULT false;
DEFINE INDEX IF NOT EXISTS account_email ON account FIELDS email UNIQUE;
DEFINE INDEX IF NOT EXISTS account_uid ON account FIELDS uid UNIQUE;
DEFINE TABLE IF NOT EXISTS permission_group SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS key ON permission_group TYPE string;
DEFINE FIELD IF NOT EXISTS name ON permission_group TYPE string;
DEFINE FIELD IF NOT EXISTS permissions ON permission_group TYPE array<string>;
DEFINE INDEX IF NOT EXISTS group_key ON permission_group FIELDS key UNIQUE;
DEFINE TABLE IF NOT EXISTS site_settings SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS signup_mode ON site_settings TYPE string ASSERT $value IN ['open', 'invitation', 'disabled'];
DEFINE TABLE IF NOT EXISTS session SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS token_hash ON session TYPE string;
DEFINE FIELD IF NOT EXISTS uid ON session TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at ON session TYPE int;
DEFINE INDEX IF NOT EXISTS session_hash ON session FIELDS token_hash UNIQUE;
DEFINE INDEX IF NOT EXISTS session_uid ON session FIELDS uid;
DEFINE TABLE IF NOT EXISTS invitation SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS token_hash ON invitation TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at ON invitation TYPE int;
DEFINE FIELD IF NOT EXISTS used ON invitation TYPE bool DEFAULT false;
DEFINE INDEX IF NOT EXISTS invitation_hash ON invitation FIELDS token_hash UNIQUE;
DEFINE TABLE IF NOT EXISTS account_token SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS token_hash ON account_token TYPE string;
DEFINE FIELD IF NOT EXISTS uid ON account_token TYPE string;
DEFINE FIELD IF NOT EXISTS purpose ON account_token TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at ON account_token TYPE int;
DEFINE INDEX IF NOT EXISTS account_token_hash ON account_token FIELDS token_hash UNIQUE;
-- Seed only missing records; preserve operator changes on restart.
IF !record::exists(site_settings:main) { CREATE site_settings:main SET signup_mode = 'invitation'; };
IF !record::exists(permission_group:reader) { CREATE permission_group:reader SET key = 'reader', name = 'Reader', permissions = ['comment', 'review']; };
IF !record::exists(permission_group:author) { CREATE permission_group:author SET key = 'author', name = 'Author', permissions = ['create_story', 'publish_story', 'comment', 'review']; };
IF !record::exists(permission_group:administrator) { CREATE permission_group:administrator SET key = 'administrator', name = 'Administrator', permissions = ['administer', 'create_story', 'publish_story', 'comment', 'review']; };
COMMIT TRANSACTION;
