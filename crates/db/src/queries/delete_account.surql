BEGIN TRANSACTION;
-- Shared write closes count-based last-administrator write-skew races.
UPDATE site_settings:main SET membership_revision = (membership_revision ?? 0) + 1;
IF (SELECT VALUE password_hash FROM account WHERE uid = $uid)[0] != $old { THROW 'credentials changed'; };
IF (SELECT VALUE group_key FROM account WHERE uid = $uid)[0] = 'administrator' AND array::len(SELECT uid FROM account WHERE group_key = 'administrator') <= 1 { THROW 'last administrator'; };
LET $owned=(SELECT VALUE uid FROM work WHERE owner=$uid);
LET $assets=(SELECT * FROM media_asset WHERE owner=$uid AND purpose NOT IN ['default_cover','genre_image','genre_hero','announcement','reaction']);
FOR $asset IN $assets { CREATE storage_deletion SET uid=$asset.uid,provider=$asset.provider,object_key=$asset.object_key; };
LET $asset_ids=(SELECT VALUE uid FROM media_asset WHERE owner=$uid AND purpose NOT IN ['default_cover','genre_image','genre_hero','announcement','reaction']);
UPDATE work SET cover=NONE,revision=revision+1 WHERE cover IN $asset_ids;
UPDATE work SET hero=NONE,revision=revision+1 WHERE hero IN $asset_ids;
DELETE media_asset WHERE owner=$uid AND purpose NOT IN ['default_cover','genre_image','genre_hero','announcement','reaction'];
DELETE work_share WHERE work IN $owned OR uid=$uid;
DELETE work_access WHERE work IN $owned OR uid=$uid;
UPDATE work_details SET value.nodes = value.nodes.map(|$node| IF $node.cover IN $asset_ids { object::extend($node,{cover:NULL}) } ELSE { $node }),revision=revision+1 WHERE work NOT IN $owned;
DELETE translation_cache WHERE string::split(scope,':')[0] IN $owned;
DELETE work_translation WHERE work IN $owned;
DELETE work_translation_source WHERE work IN $owned;
DELETE work_translation_access WHERE work IN $owned OR uid=$uid;
DELETE chapter_draft WHERE work IN $owned;
DELETE chapter_revision WHERE work IN $owned;
DELETE chapter_publication WHERE work IN $owned;
FOR $row IN (SELECT * FROM reader_state WHERE account=$uid AND work NOT IN $owned) {
 LET $f=(SELECT VALUE value FROM chapter_feedback WHERE work=$row.work AND chapter=$row.chapter)[0];
 LET $reactions=object::from_entries(($row.value.reactions ?? []).map(|$r|[$r,math::max([0,($f.reactions[$r] ?? 0)-1])]));
 UPDATE chapter_feedback SET value.ratings=math::max([0,(value.ratings ?? 0)-IF $row.value.rating!=NULL {1} ELSE {0}]),value.rating_sum=math::max([0,(value.rating_sum ?? 0)-($row.value.rating ?? 0)]),value.reactions=object::extend(value.reactions ?? {},$reactions) WHERE work=$row.work AND chapter=$row.chapter;
};
DELETE chapter_visit WHERE viewer=$reader_viewer OR work IN $owned;
DELETE chapter_metrics WHERE work IN $owned;
DELETE chapter_feedback WHERE work IN $owned;
DELETE story_lifecycle WHERE work IN $owned;
DELETE notification WHERE account=$uid OR work IN $owned OR comment IN (SELECT VALUE uid FROM chapter_comment WHERE account=$uid);
DELETE comment_like WHERE account=$uid OR comment IN (SELECT VALUE uid FROM chapter_comment WHERE account=$uid OR work IN $owned);
DELETE comment_mute WHERE account=$uid OR target=$uid;
UPDATE chapter_comment SET body='',gif=NONE,deleted=true,account='' WHERE account=$uid;
DELETE chapter_comment WHERE work IN $owned;
DELETE reader_state WHERE account=$uid OR work IN $owned;
UPDATE chapter_draft SET author_name='',updated_by='' WHERE updated_by=$uid;
UPDATE chapter_revision SET author_name='',updated_by='' WHERE updated_by=$uid;
DELETE work_details WHERE work IN $owned;
DELETE work_publication WHERE work IN $owned OR value.cover IN $asset_ids OR value.hero IN $asset_ids OR value.details.nodes[WHERE cover IN $asset_ids]!=[];
DELETE work WHERE owner=$uid;
DELETE account_profile WHERE uid = $uid;
DELETE account_preferences WHERE uid = $uid;
DELETE session WHERE uid = $uid;
DELETE account_token WHERE uid = $uid;
DELETE account WHERE uid = $uid;
COMMIT TRANSACTION;
