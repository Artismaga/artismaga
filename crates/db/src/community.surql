-- Additive community records. Application-only access; no browser database credentials.
DEFINE TABLE IF NOT EXISTS chapter_comment SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON chapter_comment TYPE string;
DEFINE FIELD IF NOT EXISTS work ON chapter_comment TYPE string;
DEFINE FIELD IF NOT EXISTS chapter ON chapter_comment TYPE string;
DEFINE FIELD IF NOT EXISTS account ON chapter_comment TYPE string;
DEFINE FIELD IF NOT EXISTS parent ON chapter_comment TYPE option<string>;
DEFINE FIELD IF NOT EXISTS body ON chapter_comment TYPE string;
DEFINE FIELD IF NOT EXISTS gif ON chapter_comment TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON chapter_comment TYPE int;
DEFINE FIELD IF NOT EXISTS revision ON chapter_comment TYPE int;
DEFINE FIELD IF NOT EXISTS deleted ON chapter_comment TYPE bool DEFAULT false;
DEFINE INDEX IF NOT EXISTS comment_identity ON chapter_comment FIELDS uid UNIQUE;
DEFINE INDEX IF NOT EXISTS comment_chapter ON chapter_comment FIELDS work,chapter;
DEFINE TABLE IF NOT EXISTS comment_like SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS comment ON comment_like TYPE string;
DEFINE FIELD IF NOT EXISTS account ON comment_like TYPE string;
DEFINE INDEX IF NOT EXISTS comment_like_identity ON comment_like FIELDS comment,account UNIQUE;
DEFINE TABLE IF NOT EXISTS comment_mute SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS account ON comment_mute TYPE string;
DEFINE FIELD IF NOT EXISTS target ON comment_mute TYPE string;
DEFINE INDEX IF NOT EXISTS comment_mute_identity ON comment_mute FIELDS account,target UNIQUE;
DEFINE TABLE IF NOT EXISTS notification SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON notification TYPE string;
DEFINE FIELD IF NOT EXISTS account ON notification TYPE string;
DEFINE FIELD IF NOT EXISTS work ON notification TYPE string;
DEFINE FIELD IF NOT EXISTS chapter ON notification TYPE string;
DEFINE FIELD IF NOT EXISTS comment ON notification TYPE string;
DEFINE FIELD IF NOT EXISTS kind ON notification TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON notification TYPE int;
DEFINE FIELD IF NOT EXISTS read ON notification TYPE bool DEFAULT false;
DEFINE INDEX IF NOT EXISTS notification_identity ON notification FIELDS uid UNIQUE;
DEFINE INDEX IF NOT EXISTS notification_owner ON notification FIELDS account,created_at;
DEFINE TABLE IF NOT EXISTS comment_gif SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON comment_gif TYPE string;
DEFINE FIELD IF NOT EXISTS url ON comment_gif TYPE string;
DEFINE INDEX IF NOT EXISTS comment_gif_identity ON comment_gif FIELDS uid UNIQUE;
DEFINE TABLE IF NOT EXISTS comment_provider SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS secret ON comment_provider TYPE string;
