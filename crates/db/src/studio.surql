-- Additive Studio, role revision and private storage schema.
BEGIN TRANSACTION;
DEFINE FIELD IF NOT EXISTS revision ON permission_group TYPE int DEFAULT 0;
DEFINE TABLE IF NOT EXISTS storage_provider SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON storage_provider TYPE string;
DEFINE FIELD IF NOT EXISTS value ON storage_provider TYPE object FLEXIBLE;
DEFINE INDEX IF NOT EXISTS storage_provider_uid ON storage_provider FIELDS uid UNIQUE;
DEFINE TABLE IF NOT EXISTS storage_state SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS revision ON storage_state TYPE int;
DEFINE FIELD IF NOT EXISTS active ON storage_state TYPE string;
DEFINE TABLE IF NOT EXISTS media_asset SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON media_asset TYPE string;
DEFINE FIELD IF NOT EXISTS owner ON media_asset TYPE string;
DEFINE FIELD IF NOT EXISTS provider ON media_asset TYPE string;
DEFINE FIELD IF NOT EXISTS object_key ON media_asset TYPE string;
DEFINE FIELD IF NOT EXISTS purpose ON media_asset TYPE string;
DEFINE FIELD IF NOT EXISTS palette ON media_asset TYPE array<string>;
DEFINE FIELD IF NOT EXISTS created_at ON media_asset TYPE int;
DEFINE INDEX IF NOT EXISTS media_uid ON media_asset FIELDS uid UNIQUE;
DEFINE TABLE IF NOT EXISTS work SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON work TYPE string;
DEFINE FIELD IF NOT EXISTS owner ON work TYPE string;
DEFINE FIELD IF NOT EXISTS title ON work TYPE string;
DEFINE FIELD IF NOT EXISTS subtitle ON work TYPE string;
DEFINE FIELD IF NOT EXISTS synopsis ON work TYPE string;
DEFINE FIELD IF NOT EXISTS work_type ON work TYPE string ASSERT $value = 'book';
DEFINE FIELD IF NOT EXISTS status ON work TYPE string DEFAULT 'draft';
DEFINE FIELD IF NOT EXISTS cover ON work TYPE option<string>;
DEFINE FIELD IF NOT EXISTS hero ON work TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON work TYPE int;
DEFINE FIELD IF NOT EXISTS updated_at ON work TYPE int;
DEFINE FIELD IF NOT EXISTS revision ON work TYPE int DEFAULT 0;
DEFINE INDEX IF NOT EXISTS work_uid ON work FIELDS uid UNIQUE;
DEFINE INDEX IF NOT EXISTS work_owner ON work FIELDS owner;
DEFINE TABLE IF NOT EXISTS work_share SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS work ON work_share TYPE string;
DEFINE FIELD IF NOT EXISTS uid ON work_share TYPE string;
DEFINE FIELD IF NOT EXISTS can_edit ON work_share TYPE bool;
DEFINE INDEX IF NOT EXISTS work_share_unique ON work_share FIELDS work,uid UNIQUE;
DEFINE TABLE IF NOT EXISTS work_access SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS work ON work_access TYPE string;
DEFINE FIELD IF NOT EXISTS uid ON work_access TYPE string;
DEFINE FIELD IF NOT EXISTS accessed_at ON work_access TYPE int;
DEFINE INDEX IF NOT EXISTS work_access_unique ON work_access FIELDS work,uid UNIQUE;
DEFINE TABLE IF NOT EXISTS storage_deletion SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uid ON storage_deletion TYPE string;
DEFINE FIELD IF NOT EXISTS provider ON storage_deletion TYPE string;
DEFINE FIELD IF NOT EXISTS object_key ON storage_deletion TYPE string;
DEFINE INDEX IF NOT EXISTS storage_deletion_uid ON storage_deletion FIELDS uid UNIQUE;
COMMIT TRANSACTION;
